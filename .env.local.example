# ================================
# 클라이언트 공개 환경변수 (NEXT_PUBLIC_ 필수)
# ================================

# Firebase 클라이언트 설정 (Firebase Console > 프로젝트 설정 > 앱)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGINGSENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Giscus 댓글 설정 (https://giscus.app 에서 설정)
NEXT_PUBLIC_GITHUB_REPO=
NEXT_PUBLIC_GITHUB_REPO_ID=
NEXT_PUBLIC_GITHUB_CATEGORY=
NEXT_PUBLIC_GITHUB_CATEGORY_ID=
NEXT_PUBLIC_GITHUB_TERM=tech-blog-comments

# Google Analytics 4 (공개 측정 ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Z8GGD8Q4L1

# ================================
# 서버 전용 환경변수 (NEXT_PUBLIC_ 없음 - 절대 노출 금지)
# Amplify/호스팅 대시보드 Environment variables에만 등록하세요.
# next.config.js 의 env 블록에 넣지 마세요. (클라이언트 번들에 인라인됨)
# ================================

# Firebase Admin SDK (Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Amplify 배포 권장: PEM을 base64 한 줄로 (docs/AMPLIFY_ENV.md 참고)
FIREBASE_PRIVATE_KEY_BASE64=
# 로컬용 대안 (한 줄 + \n). Amplify에서는 BASE64 권장
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 관리자 이메일 (GitHub 로그인 시 이 이메일만 관리자 접근 허용)
ADMIN_EMAIL=

# AWS S3 설정 (AWS IAM에서 액세스 키 발급)
# S3_* 또는 AWS_* 둘 다 지원합니다.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-northeast-2
S3_BUCKET_NAME=
